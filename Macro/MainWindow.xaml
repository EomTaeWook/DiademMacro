<mah:MetroWindow
    x:Class="Macro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:IconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:Macro.View"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    Title="{Binding Path=Title, Source={StaticResource LabelLocator}}"
    Height="680" Width="720" MinHeight="520" MinWidth="620"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Name="btnGithub">
                <StackPanel Orientation="Horizontal">
                    <IconPacks:PackIconMaterial Width="24" Height="24" Kind="Github" />
                </StackPanel>
            </Button>
            <Button Name="btnSetting">
                <StackPanel Orientation="Horizontal">
                    <IconPacks:PackIconMaterial Width="24" Height="24" Kind="ContentSaveSettingsOutline" />
                    <TextBlock Margin="4 0 0 0" VerticalAlignment="Center" Text="{Binding Path=Setting, Source={StaticResource LabelLocator}}" />
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <DockPanel HorizontalAlignment="Stretch" LastChildFill="True" VerticalAlignment="Stretch">
            <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" VerticalAlignment="Center" Content="{Binding Path=SelectProcess, Source={StaticResource LabelLocator}}"/>
                        <ComboBox Grid.Column="1" Name="comboProcess" Height="36" Margin="8,0"/>
                        <Button Grid.Column="2" Style="{DynamicResource MahApps.Styles.Button.Circle}" x:Name="btnRefresh" Width="34" Height="34">
                            <IconPacks:PackIconMaterial Width="16" Height="16" Kind="Refresh" />
                        </Button>
                        <CheckBox Grid.Column="3" x:Name="checkFix" Content="{Binding Path=Fix, Source={StaticResource LabelLocator}}" Margin="8,0" VerticalAlignment="Center"/>
                        <Grid Grid.Column="4" Width="72">
                            <Button Name="btnStart" Content="{Binding Path=Start, Source={StaticResource LabelLocator}}"/>
                            <Button Name="btnStop" Visibility="Collapsed" Content="{Binding Path=Stop, Source={StaticResource LabelLocator}}"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Name="btnAddEventItem" Content="{Binding Path=Addition, Source={StaticResource LabelLocator}}" MinWidth="86" Height="32"/>
                        <Button Name="btnRemoveEventItem" Content="{Binding Path=Removal, Source={StaticResource LabelLocator}}" MinWidth="86" Height="32" IsEnabled="False"/>
                        <Button Name="btnCopyEventItem" Content="{Binding Path=Copy, Source={StaticResource LabelLocator}}" MinWidth="86" Height="32" IsEnabled="False"/>
                        <Button Name="btnUpEventItem" Background="Transparent" Width="38" Height="32" IsEnabled="False">
                            <IconPacks:PackIconMaterial Width="20" Height="20" Kind="ArrowUpDropCircleOutline" />
                        </Button>
                        <Button Name="btnDownEventItem" Background="Transparent" Width="38" Height="32" IsEnabled="False">
                            <IconPacks:PackIconMaterial Width="20" Height="20" Kind="ArrowDownDropCircleOutline" />
                        </Button>
                        <Button Name="btnOptionEventItem" Content="{Binding Path=Option, Source={StaticResource LabelLocator}}" MinWidth="80" Height="32" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DockPanel DockPanel.Dock="Left">
                <view:EventListView x:Name="eventListView"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</mah:MetroWindow>
