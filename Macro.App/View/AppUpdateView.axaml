<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Macro.View.AppUpdateView">
  <StackPanel Spacing="14">
    <TextBlock Classes="section" Text="{Binding Heading}" />
    <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="14">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding CurrentVersionCaption}" FontSize="13" />
        <TextBlock Classes="caption" Text="{Binding LatestVersionCaption}" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap" />
    <TextBlock Classes="caption" Text="{Binding InstallHint}" TextWrapping="Wrap" />
    <ProgressBar IsVisible="{Binding IsInstalling}" Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="6" />
    <WrapPanel Margin="0,-6,0,0">
      <Button x:Name="checkButton" Content="{Binding CheckButtonText}" IsEnabled="{Binding CanCheck}" Margin="0,6,8,0" />
      <Button x:Name="installButton" Classes="accent" Content="{Binding InstallButtonText}" IsEnabled="{Binding CanInstall}" Margin="0,6,8,0" />
      <Button x:Name="releaseButton" Content="{Binding ReleaseButtonText}" Margin="0,6,8,0" />
      <Button x:Name="cancelButton" Content="{Binding CancelButtonText}" IsVisible="{Binding CanCancel}" Margin="0,6,0,0" />
    </WrapPanel>
  </StackPanel>
</UserControl>