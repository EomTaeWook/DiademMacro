<ui:UIItem xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Macro.UI" xmlns:util="clr-namespace:Utils;assembly=Utils" xmlns:view="clr-namespace:Macro.View" x:Class="Macro.View.SettingView" Title="{Binding Preferences, Source={StaticResource LabelLocator}}" Width="820" Height="740" MinWidth="700" MinHeight="520" WindowDecorations="Full" WindowStartupLocation="CenterOwner" CanResize="True" ShowActivated="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
      <Border Width="44" Height="44" Background="{StaticResource AccentSurfaceBrush}" CornerRadius="12">
        <PathIcon Width="22" Height="22" Foreground="{StaticResource AccentTextBrush}" Data="M3,5 H7 V3 H9 V9 H7 V7 H3 Z M11,5 H21 V7 H11 Z M3,11 H13 V9 H15 V15 H13 V13 H3 Z M17,11 H21 V13 H17 Z M3,17 H7 V15 H9 V21 H7 V19 H3 Z M11,17 H21 V19 H11 Z" />
      </Border>
      <TextBlock Classes="heading" Text="{Binding Preferences, Source={StaticResource LabelLocator}}" VerticalAlignment="Center" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="0,0,10,0">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Width="17" Height="17" Foreground="{StaticResource AccentTextBrush}" Data="F0 M4,3 H20 A2,2 0 0 1 22,5 V19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 V5 A2,2 0 0 1 4,3 Z M4,5 V19 H20 V5 Z M6,7 H10 V11 H6 Z M12,7 H18 V9 H12 Z M12,11 H18 V13 H12 Z M6,15 H18 V17 H6 Z" />
              <TextBlock Classes="section" Text="{Binding Common, Source={StaticResource LabelLocator}}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto">
              <Label Content="{Binding Language, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <ComboBox Grid.Column="1" x:Name="comboLanguage" SelectedValue="{Binding Config.Language, Mode=TwoWay}" Margin="0,0,0,12" />
              <Label Grid.Row="1" Content="{Binding SavePath, Source={StaticResource LabelLocator}}" Margin="0,0,16,0" />
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox x:Name="txtSavePath" Text="{Binding Config.SavePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" x:Name="browseSavePathButton" Classes="icon" ToolTip.Tip="{Binding SavePath, Source={StaticResource LabelLocator}}" AutomationProperties.Name="{Binding SavePath, Source={StaticResource LabelLocator}}" Margin="8,0,0,0" Command="{Binding SavePathButtonCmd}" CommandParameter="{Binding ElementName=txtSavePath}">
                  <PathIcon Width="17" Height="17" Data="M3,5 H10 L12,7 H21 V9 H5 L3,19 Z M6,11 H23 L20,21 H3 Z" />
                </Button>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Width="17" Height="17" Foreground="{StaticResource AccentTextBrush}" Data="F0 M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 Z M11,7 H13 V11.5 L17,14 L16,15.7 L11,12.6 Z" />
              <TextBlock Classes="section" Text="{Binding ExecutionSettings, Source={StaticResource LabelLocator}}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <Label Content="{Binding MacroMode, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <ComboBox Grid.Column="1" x:Name="comboMacroMode" SelectedValue="{Binding Config.MacroMode, Mode=TwoWay}" Margin="0,0,0,12" />
              <Label Grid.Row="1" Content="{Binding Period, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="numPeriod" Value="{Binding Config.ProcessPeriod, Mode=TwoWay}" Margin="0,0,0,12" />
              <Label Grid.Row="2" Content="{Binding ItemDelay, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="numDelay" Value="{Binding Config.ItemDelay, Mode=TwoWay}" Margin="0,0,0,12" />
              <Label Grid.Row="3" Content="{Binding DragDelay, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <NumericUpDown x:Name="numDragDelay" Value="{Binding Config.DragDelay, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" Classes="caption" Text="ms" VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
              <Label Grid.Row="4" Content="{Binding Similarity, Source={StaticResource LabelLocator}}" Margin="0,0,16,0" />
              <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto">
                <NumericUpDown x:Name="numSimilarity" Value="{Binding Config.Similarity, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" Classes="caption" Text="%" VerticalAlignment="Center" Margin="10,0,0,0" />
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <PathIcon Width="17" Height="17" Foreground="{StaticResource AccentTextBrush}" Data="F0 M4,3 H20 A2,2 0 0 1 22,5 V16 A2,2 0 0 1 20,18 H13 V20 H17 V22 H7 V20 H11 V18 H4 A2,2 0 0 1 2,16 V5 A2,2 0 0 1 4,3 Z M4,5 V16 H20 V5 Z" />
              <TextBlock Classes="section" Text="{Binding DisplaySettings, Source={StaticResource LabelLocator}}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto">
              <Label Content="{Binding SearchResultDisplay, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <ComboBox Grid.Column="1" x:Name="comboSearchResultDisplay" SelectedValue="{Binding Config.SearchImageResultDisplay, Mode=TwoWay}" Margin="0,0,0,12">
                <ComboBox.Items><x:Boolean>True</x:Boolean><x:Boolean>False</x:Boolean></ComboBox.Items>
              </ComboBox>
              <Label Grid.Row="1" Content="{Binding ShowProcessViewer, Source={StaticResource LabelLocator}}" Margin="0,0,16,12" />
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="comboProcessPreviewOpen" SelectedValue="{Binding Config.OpenProcessPreview, Mode=TwoWay}" Margin="0,0,0,12">
                <ComboBox.Items><x:Boolean>True</x:Boolean><x:Boolean>False</x:Boolean></ComboBox.Items>
              </ComboBox>
              <Label Grid.Row="2" Content="{Binding SettingProcessLocation, Source={StaticResource LabelLocator}}" Margin="0,0,16,0" />
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto,*">
                <TextBlock Classes="caption" Text="X" VerticalAlignment="Center" Margin="0,0,8,0" />
                <NumericUpDown Grid.Column="1" x:Name="numProcessLocationX" Value="{Binding Config.ProcessLocationX, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Classes="caption" Text="Y" VerticalAlignment="Center" Margin="12,0,8,0" />
                <NumericUpDown Grid.Column="3" x:Name="numProcessLocationY" Value="{Binding Config.ProcessLocationY, Mode=TwoWay}" />
              </Grid>
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <view:AppUpdateView x:Name="appUpdateView" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="btnClose" MinWidth="100" AutomationProperties.Name="{Binding Close, Source={StaticResource LabelLocator}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="M7,5 L12,10 L17,5 L19,7 L14,12 L19,17 L17,19 L12,14 L7,19 L5,17 L10,12 L5,7 Z" />
            <TextBlock Text="{Binding Close, Source={StaticResource LabelLocator}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="btnSave" Classes="accent" MinWidth="120" AutomationProperties.Name="{Binding Save, Source={StaticResource LabelLocator}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="16" Height="16" Data="F0 M5,3 H17 L21,7 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M7,5 V10 H17 V5 Z M7,14 V19 H17 V14 Z" />
            <TextBlock Text="{Binding Save, Source={StaticResource LabelLocator}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</ui:UIItem>
